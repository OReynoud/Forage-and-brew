      m_Calls: []
  m_text: "Each potion requires <b>unique ingredients</b> and <b>preparation steps</b>.\n\r\nSome
    recipes requires not a specific ingredients, but type of ingredients.\n\n\rTo
    brew a potion, a witch must <b>carefully follow the associated preparation steps</b>.
    \r\nMissing a step will result in failure.\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 6e55dff7a4d969643ae165b0a0cdc89c, type: 2}
